    <!-- Page 8 Help -->
    <string name="help_how_title">How it works</string>
    <string name="help_how_body">Listens to the system media notification → extracts album art → the engine melts it into seamless fluid light (Kawase Blur + Domain Wrapping) → optional audio spectrum/beat sync → renders to desktop or fullscreen. Everything runs locally; nothing is uploaded.</string>
    <string name="help_notif_title">Notification access</string>
    <string name="help_notif_body">Only media-playback notifications are read for public song/cover info. Private notifications (chat, SMS) are never read; data never leaves the device. If the permission is revoked, covers stop updating — use Restart listener to recover.</string>
    <string name="help_audio_title">Audio permission FAQ</string>
    <string name="help_audio_body">The app only analyzes the device\u2019s own audio output via the system Visualizer for visualization — it never records microphone audio, per Google\u2019s best practices.</string>
    <string name="help_fix_title">Cover not updating? Try</string>
    <string name="help_fix_body">1. Skip a track to trigger a new notification; 2. Re-check notification permission; 3. Restart the listener; 4. Make sure the player\u2019s notification is not collapsed; 5. Add to battery whitelist.</string>
    <string name="help_player_title">Player compatibility</string>
    <string name="help_player_body">Native support: Apple Music / Spotify / YouTube Music / SoundCloud and other standard media notifications. Chinese players (QQ Music, etc.) use custom styles — switch the player to \u201csystem notification style\u201d in its settings.</string>
    <string name="help_battery_title">Battery optimization</string>
    <string name="help_battery_body">Aggressive battery savers may freeze the background listener. Set FlowLume to \u201cUnrestricted\u201d in battery settings; in-app restart and whitelist shortcuts are provided.</string>

